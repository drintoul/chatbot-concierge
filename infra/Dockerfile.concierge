FROM python:3.12-slim

WORKDIR /app
COPY apps/concierge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/concierge/ .

RUN useradd -m concierge && mkdir -p /data && chown concierge:concierge /data
USER concierge

EXPOSE 8080
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
