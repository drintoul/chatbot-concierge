FROM python:3.12-slim

WORKDIR /app
COPY apps/chatbot-concierge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/chatbot-concierge/ .

RUN useradd -m chatbot-concierge && mkdir -p /data && chown chatbot-concierge:chatbot-concierge /data
USER chatbot-concierge

EXPOSE 8080
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
