# Copy to .env to override defaults. These are dev-only values — nothing here
# is a live secret. Set real values before deploying anywhere public.

# ---- Published ports (localhost-bound; compose-internal traffic unaffected)
# Host port for the container ollama. 11435 because a host-installed ollama
# typically owns 11434 already — inter-service traffic always uses
# http://ollama:11434 regardless of this setting.
OLLAMA_PORT=11435
# Firecrawl API port → http://localhost:3002
FIRECRAWL_PORT=3002

# ---- Ollama models pulled on first `docker compose up` by ollama-pull ----
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Firecrawl ----
# Dev-only credential for the firecrawl-internal postgres (not published).
# User/db are fixed to postgres/postgres — the nuq-postgres init scripts
# (pg_cron) fail under any other database name.
FC_POSTGRES_PASSWORD=firecrawl_dev_password
# Modest concurrency for a dev box; raise on the VPS.
FC_NUM_WORKERS=4
FC_CONCURRENT_REQUESTS=5
FC_MAX_JOBS=3
FC_BROWSER_POOL=3
# Strip images/fonts/media during scrapes (faster, less bandwidth).
FC_BLOCK_MEDIA=true
FC_LOG_LEVEL=info
