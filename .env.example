# Copy to .env to override defaults. These are dev-only values — nothing here
# is a live secret. Set real values before deploying anywhere public.

# ---- Published ports (localhost-bound; compose-internal traffic unaffected)
# Chatbot concierge API port → http://localhost:8000
CHATBOT_CONCIERGE_PORT=8000
# Extractor admin UI port → http://localhost:8001 (admin profile only)
EXTRACTOR_PORT=8001
# The concierge's public URL — baked into the embed tags concierge setup
# generates (e.g. https://chat.yourdomain.com at deploy; dev default :8000)
PUBLIC_CHATBOT_URL=http://localhost:8000

# --- Cloudflare tunnel -------------------------------------------------
# CF_TUNNEL_TOKEN: credential for a named Cloudflare Tunnel — gives the
# concierge a stable public hostname (e.g. concierge.yourdomain.com) that
# survives restarts. Get it from the Cloudflare Zero Trust dashboard →
# Networks → Tunnels → Add a tunnel → choose "Cloudflared" → copy the
# long "eyJ…" token shown for the connector. The dashboard also maps the
# public hostname to http://concierge:8080 (reachable inside docker).
#
# Treat it like a password. Until it's set, the tunnel container exits —
# that's expected.
CF_TUNNEL_TOKEN=

# ---- Ollama (shared container on the llm-network docker network) ----
# The models both services call — they must already be pulled on that
# ollama (docker exec ollama ollama pull <model>).
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
